---
import Base from '../layouts/Base.astro';
import FamilyMap from '../components/FamilyMap.astro';
---
<Base title="Mapa rodu" wider>
  <h1>Kde žili naši predkovia</h1>
  <p class="lead">Každá bodka je jedna obec a jeden rod – farba podľa rodu, veľkosť podľa počtu predkov. Kliknite na bodku pre zobrazenie mien; rody sa dajú v legende vypínať.</p>
  <FamilyMap height="calc(100vh - 230px)" />
  <p class="small muted">Polohy obcí z OpenStreetMap (stred dnešnej obce). Priehľadná bodka s čiarkovaným okrajom je len hypotéza.</p>
</Base>
