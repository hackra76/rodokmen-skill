---
import Base from '../layouts/Base.astro';
import { Content } from '../generated/zajimavosti.md';
import { lines, linesTitle } from '../lib/data.js';
---
<Base title="Zaujímavosti">
  <h1>Zaujímavosti z rodokmeňa</h1>
  <p class="lead">Čo nás pri hľadaní najviac prekvapilo – najstarší predok, spojené vetvy, remeslá a osudy.</p>
  <div class="prose"><Content /></div>

  <div class="next-step">
    <p><strong>Ponorte sa hlbšie:</strong> prejdite si jednotlivé rody, pozrite sa na mape, kde predkovia žili, alebo nájdite kohokoľvek vo vejári všetkých predkov.</p>
    <p><a class="btn" href="/rody/">{linesTitle(Object.keys(lines).length)} →</a> <a class="btn" href="/mapa/">Mapa →</a> <a class="btn" href="/vejir/">Vejár predkov →</a></p>
  </div>
</Base>
