---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { people, lineByK, genName, statusClass } from '../lib/data.js';
const list = Object.values(people).sort((a, b) => a.k - b.k);
const gens = [...new Set(list.map((p) => p.gen))];
---
<Base title="Predkovia">
  <h1>Všetci predkovia</h1>
  <p class="lead">Po generáciách, v poradí podľa Kekulého čísla (otec má číslo 2n, matka 2n + 1). Pri každej generácii vidíte, koľko predkov z možného počtu už poznáme – ostatných stále hľadáme. Pozrite sa, <a href="/hledame/">čo ešte hľadáme</a>, možno viete viac.</p>
  {gens.map((g) => (
    <>
      <h2>{genName(g)} <span class="muted small">({list.filter((p) => p.gen === g).length} z {2 ** g})</span></h2>
      <div class="table-box"><table>
        <thead><tr><th>#</th><th>Meno</th><th>Vzťah</th><th>Rod</th><th>Stav</th></tr></thead>
        <tbody>
          {list.filter((p) => p.gen === g).map((p) => (
            <tr>
              <td class="small muted">{p.k}</td>
              <td><PersonLink slug={p.slug} /></td>
              <td class="small">{p.rel}</td>
              <td class="small">{p.line && lineByK[p.line] && <><span class="dot" style={`display:inline-block;width:.6rem;height:.6rem;border-radius:50%;background:${lineByK[p.line].color};margin-right:.3rem`}></span>{lineByK[p.line].name}</>}</td>
              <td><span class={`chip ${statusClass(p.st)}`}>{p.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  ))}
</Base>
