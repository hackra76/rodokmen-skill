---
import Base from '../layouts/Base.astro';
import { stats, lines, href, config, linesTitle } from '../lib/data.js';
import fan from '../generated/fan.svg?raw';
import FamilyMap from '../components/FamilyMap.astro';
import site from '../data/site.json';
import { frontmatter as pribeh } from '../generated/pribeh.md';
const lineList = Object.values(lines).sort((a, b) => a.k - b.k);
const uvod = config.uvod ?? {};
const cards = config.zajimavosti_na_uvodu ?? [];
---
<Base title="" wide>
  <h1>{config.nazev || 'Rodokmeň'}</h1>

  {!!(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        {uvod.nadpis && <h2>{uvod.nadpis}</h2>}
        {(uvod.odstavce ?? []).map((t) => <p>{t}</p>)}
        {config.maPribeh && <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || `Prečítať: ${pribeh.title}`} →</a>}
      </div>
      {uvod.foto && (
        <a href={config.maPribeh ? '/pribehy/' : `/img/${uvod.foto}.jpg`}><img src={`/img/${uvod.foto}.jpg`} alt={uvod.foto_popis || ''} /></a>
      )}
    </section>
  )}

  {config.maPribeh && !(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        <h2>{pribeh.title}</h2>
        {pribeh.lead && <p>{pribeh.lead}</p>}
        <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || 'Prečítať príbeh'} →</a>
      </div>
    </section>
  )}

  <div class="stats">
    <div><strong>{stats.ancestors}</strong>známych predkov</div>
    <div><strong>{stats.documented}</strong>doložených matrikou</div>
    <div><strong>{stats.generations}</strong>generácií</div>
    <div><strong>{stats.records}</strong>matričných zápisov</div>
  </div>

  {cards.length > 0 && (
    <>
      <h2>Zaujímavosti</h2>
      <div class="grid2">
        {cards.map((c) => (
          <a class="card card-link" href="/zajimavosti/"><h3>{c.nadpis}</h3><p class="small muted">{c.text}</p></a>
        ))}
      </div>
      <p><a href="/zajimavosti/">Všetky zaujímavosti →</a></p>
    </>
  )}

  {site.places.length > 0 && (
    <>
      <h2>Kde žili naši predkovia</h2>
      <FamilyMap height="420px" compact />
      <p><a href="/mapa/">Celá mapa s menami a filtrom rodov →</a></p>
    </>
  )}

  {lineList.length > 0 && (
    <>
      <h2>{linesTitle(lineList.length)}</h2>
      <div class="grid2">
        {lineList.map((l) => (
          <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
            <h3>{l.name}</h3>
            <p class="small muted">{l.desc}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Rodokmeň</h2>
  <div class="fan-preview"><a class="cover" href="/vejir/" aria-label="Otvoriť vejár predkov na celú obrazovku"></a><Fragment set:html={fan} /></div>
  <p><a class="btn" href="/vejir/">Otvoriť vejár predkov na celú obrazovku →</a> <a href="/predci/" style="margin-left:1rem">alebo zoznam všetkých predkov</a></p>
</Base>
