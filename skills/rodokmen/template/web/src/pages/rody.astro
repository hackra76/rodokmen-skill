---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { lines, people, href, linesTitle } from '../lib/data.js';
const list = Object.values(lines).sort((a, b) => a.k - b.k);
---
<Base title="Rody">
  <h1>{linesTitle(list.length)}</h1>
  <p class="lead">Rodokmeň sa vetví podľa ôsmich prastarých rodičov – rodičov starých rodičov. Každý rod je jedna z týchto vetiev so všetkými svojimi predkami.</p>
  {list.length === 0 && <p>Rody sa zobrazia, až keď budú v rodokmeni známi prastarí rodičia.</p>}
  <h2>Po otcovi</h2>
  <div class="grid2">
    {list.filter((l) => l.k < 12).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} predkov · začína u {people[l.root].name}</p>
      </a>
    ))}
  </div>
  <h2>Po matke</h2>
  <div class="grid2">
    {list.filter((l) => l.k >= 12).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} predkov · začína u {people[l.root].name}</p>
      </a>
    ))}
  </div>
</Base>
